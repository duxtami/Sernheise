<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!--
      Only occupies space during the brief success reveal at the very end of export:
      staying GONE (not just its child) for the whole progress phase is what removes the
      dead space that used to sit above the title.
    -->
    <FrameLayout
        android:id="@+id/exportIconFrame"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/exportSuccessIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check"
            app:tint="@color/sern_accent"
            android:contentDescription="@null" />

    </FrameLayout>

    <!-- M3 title-medium scale: compact, confident, not oversized for a utility dialog. -->
    <TextView
        android:id="@+id/exportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/exporting"
        android:textColor="@color/sern_text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01" />

    <!-- M3 body-medium scale, secondary color : one clear step down from the title. -->
    <TextView
        android:id="@+id/exportStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/export_status_preparing"
        android:textColor="@color/sern_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/exportProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="@color/sern_accent"
        app:trackColor="@color/sern_slider_track"
        app:indicatorDirectionLinear="startToEnd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exportPercent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0%"
            android:textColor="@color/sern_text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/exportEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sern_text_secondary"
            android:textSize="12sp"
            tools:text="~12s left" />

    </LinearLayout>

</LinearLayout>
